# ==============================================================================
# ANABE HOTEL — Environment Variables Configuration Template
# Keep this file free of sensitive secrets. Copy to .env for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# PostgreSQL Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pool.neon.tech/neondb?sslmode=require

# Authentication JWT Secret (min 32 bytes random string)
JWT_SECRET=replace_with_a_secure_random_32_character_string

# Allowed Frontend URL for CORS (Vercel domain or custom domain)
FRONTEND_URL=https://your-hotel-app.vercel.app
CORS_ORIGIN=https://your-hotel-app.vercel.app

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=dahl4gfwe
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Hotel Contact Details
HOTEL_NAME=ANABE HOTEL
HOTEL_OWNER_EMAIL=owneranabehotel@gmail.com
HOTEL_PRIMARY_PHONE=0788 845 520
HOTEL_SECONDARY_PHONE=0783 218 170
HOTEL_PRIMARY_WHATSAPP=250788845520
HOTEL_SECONDARY_WHATSAPP=250783218170

# Optional Email Notification Service
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="ANABE HOTEL" <owneranabehotel@gmail.com>

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Points the Vite frontend directly to the deployed Render backend API URL
VITE_API_URL=https://anabe-hotel.onrender.com
